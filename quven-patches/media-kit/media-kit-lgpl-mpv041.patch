diff --git a/buildscripts/scripts/expat.sh b/buildscripts/scripts/expat.sh
new file mode 100755
index 0000000..da5c3ca
--- /dev/null
+++ b/buildscripts/scripts/expat.sh
@@ -0,0 +1,43 @@
+#!/bin/bash -e
+
+. ../../include/depinfo.sh
+. ../../include/path.sh
+
+build=_build$ndk_suffix
+
+if [ "$1" == "build" ]; then
+	true
+elif [ "$1" == "clean" ]; then
+	rm -rf $build
+	exit 0
+else
+	exit 255
+fi
+
+case "$ndk_triple" in
+	aarch64*) android_abi=arm64-v8a ;;
+	arm-*) android_abi=armeabi-v7a ;;
+	i686*) android_abi=x86 ;;
+	x86_64*) android_abi=x86_64 ;;
+	*) echo "unknown Android ABI for $ndk_triple" >&2; exit 1 ;;
+esac
+
+cmake -S expat -B $build -G Ninja \
+	-DCMAKE_TOOLCHAIN_FILE="$ANDROID_HOME/ndk/$v_ndk/build/cmake/android.toolchain.cmake" \
+	-DANDROID_ABI="$android_abi" \
+	-DANDROID_PLATFORM=android-21 \
+	-DCMAKE_INSTALL_PREFIX=/ \
+	-DCMAKE_BUILD_TYPE=Release \
+	-DCMAKE_POSITION_INDEPENDENT_CODE=ON \
+	-DEXPAT_SHARED_LIBS=OFF \
+	-DEXPAT_BUILD_TOOLS=OFF \
+	-DEXPAT_BUILD_EXAMPLES=OFF \
+	-DEXPAT_BUILD_TESTS=OFF \
+	-DEXPAT_BUILD_DOCS=OFF \
+	-DEXPAT_BUILD_PKGCONFIG=ON \
+	-DEXPAT_WITH_LIBBSD=OFF \
+	-DEXPAT_WITH_GETRANDOM=OFF \
+	-DEXPAT_WITH_SYS_GETRANDOM=OFF
+
+ninja -C $build -j$cores
+DESTDIR="$prefix_dir" ninja -C $build install
diff --git a/buildscripts/scripts/ffmpeg.sh b/buildscripts/scripts/ffmpeg.sh
new file mode 100755
index 0000000..2c8d4f0
--- /dev/null
+++ b/buildscripts/scripts/ffmpeg.sh
@@ -0,0 +1,209 @@
+#!/bin/bash -e
+
+. ../../include/depinfo.sh
+. ../../include/path.sh
+
+if [ "$1" == "build" ]; then
+	true
+elif [ "$1" == "clean" ]; then
+	rm -rf _build$ndk_suffix
+	exit 0
+else
+	exit 255
+fi
+
+mkdir -p _build$ndk_suffix
+cd _build$ndk_suffix
+
+cpu=armv7-a
+[[ "$ndk_triple" == "aarch64"* ]] && cpu=armv8-a
+[[ "$ndk_triple" == "x86_64"* ]] && cpu=generic
+[[ "$ndk_triple" == "i686"* ]] && cpu="i686 --disable-asm"
+
+cpuflags=
+[[ "$ndk_triple" == "arm"* ]] && cpuflags="$cpuflags -mfpu=neon -mcpu=cortex-a8"
+
+../configure \
+	--target-os=android --enable-cross-compile --cross-prefix=$ndk_triple- --ar=$AR --cc=$CC --nm=llvm-nm --ranlib=$RANLIB \
+	--arch=${ndk_triple%%-*} --cpu=$cpu --pkg-config=pkg-config \
+	--extra-cflags="-I$prefix_dir/include $cpuflags" --extra-ldflags="-L$prefix_dir/lib" \
+	\
+	--disable-gpl \
+	--disable-nonfree \
+	--enable-version3 \
+	--enable-static \
+	--disable-shared \
+	--disable-vulkan \
+	--enable-iconv \
+	--disable-stripping \
+	--pkg-config-flags=--static \
+	\
+	--disable-muxers \
+	--enable-decoders \
+	--disable-encoders \
+	--disable-demuxers \
+	--disable-parsers \
+	--disable-protocols \
+	--disable-devices \
+	--disable-filters \
+	--disable-doc \
+	--disable-avdevice \
+	--disable-programs \
+	--disable-gray \
+	--disable-swscale-alpha \
+	\
+	--enable-jni \
+	--enable-bsfs \
+	--enable-mediacodec \
+	\
+	--disable-dxva2 \
+	--disable-vaapi \
+	--disable-vdpau \
+	--disable-bzlib \
+	--disable-linux-perf \
+	--disable-videotoolbox \
+	--disable-audiotoolbox \
+	\
+	--enable-small \
+	--enable-hwaccels \
+	--enable-optimizations \
+	--enable-runtime-cpudetect \
+	\
+	--enable-mbedtls \
+	\
+	--enable-libdav1d \
+	\
+	--enable-libxml2 \
+	\
+	--enable-avutil \
+	--enable-avcodec \
+	--enable-avfilter \
