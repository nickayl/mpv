diff --git a/buildscripts/scripts/libiconv.sh b/buildscripts/scripts/libiconv.sh
new file mode 100755
index 0000000..f18f246
--- /dev/null
+++ b/buildscripts/scripts/libiconv.sh
@@ -0,0 +1,27 @@
+#!/bin/bash -e
+
+. ../../include/depinfo.sh
+. ../../include/path.sh
+
+build=_build$ndk_suffix
+
+if [ "$1" == "build" ]; then
+	true
+elif [ "$1" == "clean" ]; then
+	rm -rf $build
+	exit 0
+else
+	exit 255
+fi
+
+rm -rf $build
+mkdir -p $build
+cd $build
+
+CFLAGS="-fPIC" \
+CPPFLAGS="-I$prefix_dir/include" \
+LDFLAGS="-L$prefix_dir/lib" \
+../configure --host=$ndk_triple --prefix=/ --enable-static --disable-shared --disable-nls
+
+make -j$cores
+make DESTDIR="$prefix_dir" install
diff --git a/buildscripts/scripts/fontconfig.sh b/buildscripts/scripts/fontconfig.sh
new file mode 100755
index 0000000..efa8d59
--- /dev/null
+++ b/buildscripts/scripts/fontconfig.sh
@@ -0,0 +1,39 @@
+#!/bin/bash -e
+
+. ../../include/depinfo.sh
+. ../../include/path.sh
+
+build=_build$ndk_suffix
+
+if [ "$1" == "build" ]; then
+	true
+elif [ "$1" == "clean" ]; then
+	rm -rf $build
+	exit 0
+else
+	exit 255
+fi
+
+unset CC CXX # meson wants these unset
+
+if ! grep -q 'Noto Sans' src/fcinit.c; then
+	git apply ../../patches/fontconfig/android_system_font_fallback.patch
+fi
+
+meson setup $build --cross-file "$prefix_dir"/crossfile.txt --prefix / \
+	-Ddoc=disabled \
+	-Ddoc-txt=disabled \
+	-Ddoc-man=disabled \
+	-Ddoc-pdf=disabled \
+	-Ddoc-html=disabled \
+	-Dnls=disabled \
+	-Dtests=disabled \
+	-Dtools=disabled \
+	-Dcache-build=disabled \
+	-Diconv=disabled \
+	-Ddefault-fonts-dirs=/system/fonts \
+	-Dadditional-fonts-dirs=no \
+	-Dcache-dir=/data/data/tv.quven.mobile/cache/fontconfig
+
+ninja -C $build -j$cores
+DESTDIR="$prefix_dir" ninja -C $build install
